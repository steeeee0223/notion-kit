{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "matchPackageNames": ["@notion-kit/*"],
      "enabled": false
    }
  ],
  "updateInternalDeps": true,
  "rangeStrategy": "bump",
  "automerge": false,
  "baseBranchPatterns": ["feat/renovate"],
  "npm": {
    "managerFilePatterns": ["/(^|/)package\\.json\\.hbs$/"]
  }
}
