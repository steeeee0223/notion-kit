{
  "name": "@notion-kit/auth",
  "version": "1.2.0",
  "type": "module",
  "bugs": {
    "url": "https://github.com/steeeee0223/notion-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/steeeee0223/notion-kit.git",
    "directory": "packages/auth"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./client": {
      "types": "./dist/client.d.mts",
      "default": "./dist/client.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "license": "MIT",
  "scripts": {
    "build": "tsdown",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "db:push": "pnpm with-env drizzle-kit push",
    "dev": "pnpm with-env drizzle-kit studio",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "generate": "auth generate --config src/schema-auth.ts --adapter drizzle --dialect postgresql --output src/db/schemas.ts -y && prettier --write src/db/schemas.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "with-env": "dotenv -e ../../.env --",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/infra": "^0.4.9",
    "@better-auth/passkey": "^1.7.5",
    "@better-auth/stripe": "^1.7.5",
    "@better-fetch/fetch": "^1.3.2",
    "@notion-kit/schemas": "workspace:*",
    "@supabase/supabase-js": "catalog:supabase",
    "@t3-oss/env-core": "catalog:env",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.1",
    "pg": "^8.22.0",
    "stripe": "catalog:stripe",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@notion-kit/config": "workspace:*",
    "@notion-kit/eslint-config": "workspace:*",
    "@notion-kit/prettier-config": "workspace:*",
    "@notion-kit/tsconfig": "workspace:*",
    "@types/node": "catalog:node",
    "@types/pg": "^8.20.0",
    "auth": "1.7.5",
    "dotenv-cli": "catalog:env",
    "drizzle-kit": "^0.31.9",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:test"
  },
  "prettier": "@notion-kit/prettier-config"
}
