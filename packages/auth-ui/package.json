{
  "name": "@notion-kit/auth-ui",
  "version": "1.2.0",
  "bugs": {
    "url": "https://github.com/steeeee0223/notion-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/steeeee0223/notion-kit.git",
    "directory": "packages/auth-ui"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsdown --watch",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "test": "vitest run"
  },
  "prettier": "@notion-kit/prettier-config",
  "dependencies": {
    "@hookform/resolvers": "catalog:ui",
    "@notion-kit/auth": "workspace:*",
    "@notion-kit/cn": "workspace:*",
    "@notion-kit/i18n": "workspace:*",
    "@notion-kit/icons": "workspace:*",
    "@notion-kit/schemas": "workspace:*",
    "@notion-kit/settings-panel": "workspace:*",
    "react-hook-form": "catalog:ui",
    "ua-parser-js": "^2.0.9",
    "uuid": "catalog:uuid"
  },
  "devDependencies": {
    "@notion-kit/config": "workspace:*",
    "@notion-kit/eslint-config": "workspace:*",
    "@notion-kit/prettier-config": "workspace:*",
    "@notion-kit/tsconfig": "workspace:*",
    "@testing-library/react": "catalog:rtl",
    "@testing-library/user-event": "catalog:rtl",
    "@vitejs/plugin-react": "catalog:test",
    "babel-plugin-react-compiler": "catalog:react-compiler",
    "eslint": "catalog:",
    "jsdom": "catalog:rtl",
    "prettier": "catalog:",
    "react-compiler-runtime": "catalog:react-compiler",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:test"
  },
  "peerDependencies": {
    "@notion-kit/ui": "workspace:*",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "zod": "catalog:"
  }
}
