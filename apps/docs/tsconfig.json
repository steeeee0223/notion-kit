{
  "extends": "@notion-kit/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "rootDirs": [".", "./.react-router/types"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src",
    "scripts",
    "vite.config.ts",
    "react-router.config.ts",
    "source.config.ts",
    ".react-router/types/**/*"
  ],
  "exclude": ["node_modules", "build"]
}
