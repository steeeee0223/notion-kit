{
  "name": "@notion-kit/docs",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "build": "pnpm build:stories && pnpm build:registry && react-router build",
    "build:stories": "tsx scripts/build-stories.ts",
    "build:registry": "tsx scripts/build-registry.ts",
    "clean": "git clean -xdf .cache .react-router .source .turbo build node_modules",
    "dev": "pnpm build:stories && react-router dev --port 3000",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "pnpm build:stories && react-router typegen && tsc --noEmit"
  },
  "prettier": "@notion-kit/prettier-config",
  "dependencies": {
    "@dnd-kit/dom": "catalog:ui",
    "@dnd-kit/helpers": "catalog:ui",
    "@dnd-kit/react": "catalog:ui",
    "@fumadocs/story": "^1.5.0",
    "@notion-kit/auth-ui": "workspace:*",
    "@notion-kit/cn": "workspace:*",
    "@notion-kit/code-block": "workspace:*",
    "@notion-kit/cool-blocks": "workspace:*",
    "@notion-kit/hooks": "workspace:*",
    "@notion-kit/i18n": "workspace:*",
    "@notion-kit/icons": "workspace:*",
    "@notion-kit/map": "workspace:*",
    "@notion-kit/registry": "workspace:*",
    "@notion-kit/schemas": "workspace:*",
    "@notion-kit/settings-panel": "workspace:*",
    "@notion-kit/table-hook": "workspace:*",
    "@notion-kit/table-view": "workspace:*",
    "@notion-kit/ui": "workspace:*",
    "@notion-kit/utils": "workspace:*",
    "@react-router/node": "^7.18.4",
    "@react-router/serve": "^7.18.4",
    "@stripe/stripe-js": "catalog:stripe",
    "fumadocs-core": "^16.17.5",
    "fumadocs-mdx": "^15.4.7",
    "fumadocs-ui": "^16.17.5",
    "isbot": "^5.1.0",
    "lucide-react": "^1.58.0",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "react-hotkeys-hook": "catalog:ui",
    "react-router": "^7.18.4",
    "uuid": "catalog:uuid",
    "zod": "catalog:",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@notion-kit/eslint-config": "workspace:*",
    "@notion-kit/prettier-config": "workspace:*",
    "@notion-kit/tsconfig": "workspace:*",
    "@notion-kit/validators": "workspace:*",
    "@react-router/dev": "^7.18.4",
    "@tailwindcss/vite": "catalog:tailwind-v4",
    "@types/mdx": "^2.0.13",
    "@types/node": "catalog:node",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "@vercel/react-router": "^1.3.7",
    "eslint": "catalog:",
    "msw": "catalog:test",
    "prettier": "catalog:",
    "tailwindcss": "catalog:tailwind-v4",
    "tsx": "^4.19.3",
    "typescript": "catalog:",
    "vite": "^8.0.13"
  },
  "type": "module"
}
